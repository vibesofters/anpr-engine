{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anpr-engine.vibesofters.com/schemas/internal/v1/anpr-private-inference-response-v1.schema.json",
  "title": "AnprPrivateInferenceResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "admission_id", "status", "prediction", "prediction_source", "decoding_changed_raw", "structural_validity", "informational_confidence", "detection", "models", "crop_policy", "timings_ms", "error_code"],
  "properties": {
    "schema_version": {"const": "anpr-private-inference-response-v1"},
    "request_id": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "maxLength": 26},
    "admission_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,64}$", "maxLength": 64},
    "status": {"type": "string", "enum": ["prediction_available", "recognition_unresolved", "no_plate_detected", "multiple_detections", "crop_refinement_failed"]},
    "prediction": {"type": ["string", "null"], "pattern": "^[0-9A-Z ]{1,16}$", "maxLength": 16},
    "prediction_source": {"const": "existing_project_decoder"},
    "decoding_changed_raw": {"type": "boolean"},
    "structural_validity": {"type": "string", "enum": ["valid", "invalid", "not_run"]},
    "informational_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_count", "selection_rule", "box_xyxy_normalized", "informational_confidence"],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "selection_rule": {"const": "highest_confidence_then_box_coordinates"},
        "box_xyxy_normalized": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}
          ]
        },
        "informational_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detection", "recognition"],
      "properties": {
        "detection": {"$ref": "#/$defs/DetectionModelIdentity"},
        "recognition": {"$ref": "#/$defs/RecognitionModelIdentity"}
      }
    },
    "crop_policy": {"const": "BLUE_BAND_GLYPH_QUAD_V1"},
    "timings_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "validation", "detection", "crop_refinement", "recognition"],
      "properties": {
        "total": {"type": "number", "minimum": 0, "maximum": 120000},
        "validation": {"type": "number", "minimum": 0, "maximum": 120000},
        "detection": {"type": "number", "minimum": 0, "maximum": 120000},
        "crop_refinement": {"type": "number", "minimum": 0, "maximum": 120000},
        "recognition": {"type": "number", "minimum": 0, "maximum": 120000}
      }
    },
    "error_code": {
      "type": ["string", "null"],
      "enum": [null, "NO_PLATE_DETECTED", "MULTIPLE_DETECTIONS_TOP1_SELECTED", "CROP_REFINEMENT_FAILED", "RECOGNITION_UNRESOLVED", "STRUCTURAL_VALIDATION_FAILED"]
    }
  },
  "$defs": {
    "DetectionModelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "sha256"],
      "properties": {
        "model_id": {"const": "detection-v3-20260827"},
        "sha256": {"const": "0d5e9b52fae5638e0ef1badafdeb53fe0771d056e43c4953d13cceed520e71ea"}
      }
    },
    "RecognitionModelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "sha256"],
      "properties": {
        "model_id": {"const": "m3-v4-stroke-20260914"},
        "sha256": {"const": "25b6e4af757b87da75162293a28274e3a0ecbb7f29bc55489b7132e353ad5ff7"}
      }
    }
  }
}
