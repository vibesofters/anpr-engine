  "schema_version": "anpr-safe-logging-contract-v1",
  "allowed_fields": ["timestamp", "severity", "request_id", "route_category", "status_code", "error_code", "stage_timings_ms", "capacity_state", "application_version", "api_version", "schema_version", "model_versions", "health_state", "readiness_state"],
