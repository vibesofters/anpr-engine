# Dataset payloads and sensitive/local data
# Ignore everything first, then allow only reviewed small policy/metadata files.
/datasets/**
!/datasets/**/
new_datasets2/
!/datasets/DATASET_STORAGE.md
!/datasets/sources/*/source-v*/SOURCE.md
!/datasets/sources/*/source-v*/LICENSE.md
!/datasets/sources/*/source-v*/inventory.json
!/datasets/canonical/detection/v*/README.md
!/datasets/canonical/recognition/v*/README.md
!/datasets/canonical/recognition/*/v*/README.md
!/datasets/golden/README.md
!/datasets/hard_cases/README.md
!/datasets/derived/recognition/*/README.md
# Source checksum manifests are local payload integrity evidence, not reviewed metadata.
/datasets/sources/*/source-v*/checksums.sha256

