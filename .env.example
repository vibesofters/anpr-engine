# Safe, non-secret local examples only. Copy to .env for local overrides.
# Model behavior, thresholds, dimensions, padding, seeds, and augmentations
# belong in versioned YAML configuration, not here.

ANPR_DATASET_ROOT=./datasets
ANPR_ARTIFACT_ROOT=./artifacts
ANPR_PRIVATE_MODEL_BUNDLE=/path/to/owner-controlled-model-bundle
ANPR_DEVICE=cpu
ANPR_LOG_LEVEL=INFO

# Private inference service. Inject the credential through the deployment
# secret manager; never commit its value.
ANPR_SERVICE_ENV=development
ANPR_SERVICE_HOST=127.0.0.1
ANPR_SERVICE_PORT=8080
ANPR_INFERENCE_DEVICE=cpu
ANPR_INFERENCE_DEADLINE_SECONDS=120
ANPR_APPLICATION_VERSION=0.0.0
ANPR_INTERNAL_SERVICE_CREDENTIAL=

# External-store credential names are intentionally absent until a backend is
# selected and its secret-handling contract is approved.
